# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected at runtime from user secrets.
# Configure this via your environment variables or local secret system.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Injected at runtime with the hosted service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
